[Unit]
Description=Fleet Telemetry FastAPI
After=network.target

[Service]
User=ubuntu
WorkingDirectory=@REPO_ROOT@
Environment="PATH=@REPO_ROOT@/venv/bin"
ExecStart=@REPO_ROOT@/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
