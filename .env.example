# DataHub GMS Endpoint (Default for EC2 SSH Reverse Tunnel: http://127.0.0.1:18080)
# Local Dev Default: http://localhost:8080
DATAHUB_GMS_URL=http://127.0.0.1:18080

# Optional DataHub GMS Bearer Token (Leave empty if unauthenticated)
DATAHUB_GMS_TOKEN=

# Enable/Disable DataHub MCP Server Integration
DATAHUB_MCP_ENABLED=true
